<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AMR.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AMR.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Status Ribbon -->
    <div id="status-ribbon" class="d-flex align-items-center px-3 gap-4 text-white" style="background:#2c3e50; height:32px; font-size:0.78rem; overflow-x:auto; white-space:nowrap;">
        <!-- AMR Status -->
        <span class="d-flex align-items-center gap-1">
            <i class="bi bi-robot"></i> AMR
            <span id="rb-robot-state" class="badge bg-secondary">--</span>
            <span id="rb-work-status" class="badge bg-secondary">--</span>
        </span>
        <!-- Cobot -->
        <span class="d-flex align-items-center gap-1">
            <i class="bi bi-gear"></i> Cobot
            <span id="rb-cobot-mode" class="badge bg-secondary">--</span>
            <span id="rb-cobot-prog" class="badge bg-secondary">--</span>
        </span>
        <!-- Tower Lamp -->
        <span class="d-flex align-items-center gap-1">
            <i class="bi bi-lightbulb"></i>
            <i id="rb-lamp-green" class="bi bi-circle-fill" style="color:#555; font-size:0.7rem;"></i>
            <i id="rb-lamp-yellow" class="bi bi-circle-fill" style="color:#555; font-size:0.7rem;"></i>
            <i id="rb-lamp-red" class="bi bi-circle-fill" style="color:#555; font-size:0.7rem;"></i>
        </span>
        <!-- Port Detection -->
        <span class="d-flex align-items-center gap-1">
            <i class="bi bi-box-seam"></i>
            <span id="rb-port1" class="badge bg-secondary">P1</span>
            <span id="rb-port2" class="badge bg-secondary">P2</span>
            <span id="rb-port3" class="badge bg-secondary">P3</span>
            <span id="rb-port4" class="badge bg-secondary">P4</span>
        </span>
        <!-- Battery -->
        <span class="d-flex align-items-center gap-1">
            <i id="rb-batt-icon" class="bi bi-battery-half"></i>
            <span id="rb-battery">--%</span>
        </span>
        <!-- Control Buttons -->
        <span class="d-flex align-items-center gap-1 ms-auto">
            <button id="btn-reset" class="btn btn-sm btn-outline-light py-0 px-2" style="font-size:0.7rem;" title="Reset (코봇 복구)">
                <i class="bi bi-arrow-counterclockwise"></i> Reset
            </button>
            <button id="btn-manual-auto" class="btn btn-sm btn-outline-warning py-0 px-2" style="font-size:0.7rem;" title="Manual/Auto 토글">
                <i class="bi bi-toggles"></i> M/A
            </button>
            <button id="btn-buzz-off" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size:0.7rem;" title="부저 OFF">
                <i class="bi bi-volume-mute"></i> Buzz Off
            </button>
        </span>
    </div>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3" style="margin-top:0;">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">AMR.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Settings">설정</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Simulation">Simulation</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/AmrMonitoring">AMR Monitoring</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/CobotMonitoring">Cobot Monitoring</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/IoModuleMonitoring">I/O Module</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Camera">Camera</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Sequence">Sequence</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Sound">Sound</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/AutoCharge">Auto Charge</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AMR.Web - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        (function () {
            // Reset 버튼 — 클릭 시 코봇 복구 시퀀스
            $('#btn-reset').on('click', function () {
                if (!confirm('리셋(코봇 복구 시퀀스)을 ���행하시겠습니까?')) return;
                var $btn = $(this).prop('disabled', true);
                $.post('/StatusRibbon?handler=Reset')
                    .always(function () { $btn.prop('disabled', false); });
            });

            // Manual/Auto 토글 — 클릭 즉시 전환
            $('#btn-manual-auto').on('click', function () {
                if (!confirm('Manual/Auto 모드를 전환하시겠습니까?')) return;
                var $btn = $(this).prop('disabled', true);
                $.post('/StatusRibbon?handler=ManualAutoToggle')
                    .always(function () { $btn.prop('disabled', false); });
            });

            // Buzz Off 버튼
            $('#btn-buzz-off').on('click', function () {
                $.post('/StatusRibbon?handler=BuzzOff');
            });

            function pollRibbon() {
                $.getJSON('/StatusRibbon?handler=Status', function (res) {
                    if (!res.success) return;
                    var d = res.data;

                    // AMR
                    var $rs = $('#rb-robot-state');
                    $rs.text(d.amrConnected ? d.robotState : 'OFF');
                    $rs.attr('class', 'badge ' + (d.amrConnected
                        ? (d.robotState === 'Started' ? 'bg-success' : d.robotState === 'Paused' ? 'bg-warning text-dark' : 'bg-info')
                        : 'bg-dark'));

                    var $ws = $('#rb-work-status');
                    $ws.text(d.amrConnected ? d.workStatus : '--');
                    $ws.attr('class', 'badge ' + (d.workStatus === 'Moving' ? 'bg-primary' : 'bg-secondary'));

                    // Cobot mode
                    var $cm = $('#rb-cobot-mode');
                    $cm.text(d.cobotConnected ? d.cobotAutoManual : 'OFF');
                    $cm.attr('class', 'badge ' + (d.cobotConnected
                        ? (d.cobotAutoManual === 'Auto' ? 'bg-success' : 'bg-warning text-dark')
                        : 'bg-dark'));

                    // Cobot program
                    var $cp = $('#rb-cobot-prog');
                    $cp.text(d.cobotConnected ? d.cobotProgram : '--');
                    $cp.attr('class', 'badge ' + (d.cobotProgram === 'Run' ? 'bg-success' : d.cobotProgram === 'Stop' ? 'bg-danger' : 'bg-secondary'));

                    // Tower lamp
                    $('#rb-lamp-green').css('color', d.lampGreen ? '#2ecc71' : '#555');
                    $('#rb-lamp-yellow').css('color', d.lampYellow ? '#f1c40f' : '#555');
                    $('#rb-lamp-red').css('color', d.lampRed ? '#e74c3c' : '#555');

                    // Port detection
                    ['port1','port2','port3','port4'].forEach(function(p, i) {
                        var $el = $('#rb-' + p);
                        $el.attr('class', 'badge ' + (d[p] ? 'bg-success' : 'bg-secondary'));
                    });

                    // Battery
                    var batt = d.batteryLevel;
                    $('#rb-battery').text(d.amrConnected ? batt.toFixed(1) + '%' : '--%');
                    var icon = batt >= 75 ? 'bi-battery-full' : batt >= 40 ? 'bi-battery-half' : batt >= 10 ? 'bi-battery-low' : 'bi-battery';
                    $('#rb-batt-icon').attr('class', 'bi ' + icon).css('color', batt < 20 ? '#e74c3c' : batt < 40 ? '#f1c40f' : '#2ecc71');
                });
            }

            pollRibbon();
            setInterval(pollRibbon, 2000);
        })();
    </script>
</body>
</html>