@page
@model AMR.Web.Pages.CameraModel
@{
    ViewData["Title"] = "Camera";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Camera</h4>
        <span id="camBadge" class="badge @(Model.IsConnected ? "bg-success" : "bg-secondary")">
            Camera: @(Model.IsConnected ? "연결됨" : "확인 중...")
        </span>
    </div>

    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label form-label-sm mb-0"><strong>카메라</strong></label>
                    <select id="cameraSelect" class="form-select form-select-sm" style="min-width: 220px;">
                        <option value="">-- 스캔하세요 --</option>
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label form-label-sm mb-0"><strong>백엔드</strong></label>
                    <select id="backendSelect" class="form-select form-select-sm">
                        <option value="any">일반 (USB)</option>
                        <option value="obsensor">OBSENSOR (Orbbec)</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button id="btnScanCameras" class="btn btn-sm btn-outline-secondary">
                        카메라 스캔
                    </button>
                </div>
                <div class="col-auto">
                    <button id="btnOpenCamera" class="btn btn-sm btn-primary">
                        열기
                    </button>
                </div>
                <div class="col-auto">
                    <span id="scanSpinner" class="spinner-border spinner-border-sm text-secondary" style="display:none;"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header py-2">
                    <strong>RGB Camera</strong>
                </div>
                <div class="card-body text-center p-2">
                    <img id="rgbFeed" src="/Camera?handler=RgbStream"
                         style="max-width: 100%; height: auto; border: 1px solid #ddd; background: #000;"
                         alt="RGB Camera Feed" />
                </div>
            </div>
        </div>
        <div class="col-md-6" id="depthPanel">
            <div class="card">
                <div class="card-header py-2">
                    <strong>Depth Camera</strong>
                </div>
                <div class="card-body text-center p-2">
                    <img id="depthFeed" src="/Camera?handler=DepthStream"
                         style="max-width: 100%; height: auto; border: 1px solid #ddd; background: #000;"
                         alt="Depth Camera Feed" />
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                    <strong>QR Code Detection</strong>
                    <span id="qrBadge" class="badge bg-secondary">감지 안됨</span>
                </div>
                <div class="card-body py-2">
                    <table class="table table-sm table-borderless mb-0">
                        <tr>
                            <td style="width: 140px;"><strong>내용</strong></td>
                            <td id="qrText" class="text-muted">-</td>
                        </tr>
                        <tr>
                            <td><strong>QR 중심 (px)</strong></td>
                            <td id="qrCenter" class="text-muted">-</td>
                        </tr>
                        <tr>
                            <td><strong>회전 각도</strong></td>
                            <td id="qrAngle" class="text-muted">-</td>
                        </tr>
                        <tr>
                            <td><strong>카메라 중심 (px)</strong></td>
                            <td id="frameCenter" class="text-muted">-</td>
                        </tr>
                        <tr>
                            <td><strong>Delta (px)</strong></td>
                            <td id="qrDelta" class="text-muted">-</td>
                        </tr>
                        <tr>
                            <td><strong>감지 시각</strong></td>
                            <td id="qrTime" class="text-muted">-</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header py-2">
                    <strong>Offset & Final Movement</strong>
                </div>
                <div class="card-body py-2">
                    <div class="row g-2 mb-2">
                        <div class="col-4">
                            <label class="form-label form-label-sm mb-0"><strong>Offset X (px)</strong></label>
                            <input type="number" id="offsetX" class="form-control form-control-sm" value="0" step="0.1" />
                        </div>
                        <div class="col-4">
                            <label class="form-label form-label-sm mb-0"><strong>Offset Y (px)</strong></label>
                            <input type="number" id="offsetY" class="form-control form-control-sm" value="0" step="0.1" />
                        </div>
                        <div class="col-4">
                            <label class="form-label form-label-sm mb-0"><strong>Offset Angle (&deg;)</strong></label>
                            <input type="number" id="offsetAngle" class="form-control form-control-sm" value="0" step="0.1" />
                        </div>
                    </div>
                    <hr class="my-2" />
                    <table class="table table-sm table-borderless mb-0">
                        <tr>
                            <td style="width: 140px;"><strong>최종 이동 좌표</strong></td>
                            <td id="finalCoord" class="text-muted">-</td>
                        </tr>
                        <tr>
                            <td><strong>최종 이동 각도</strong></td>
                            <td id="finalAngle" class="text-muted">-</td>
                        </tr>
                        <tr>
                            <td><strong>이동 거리 (px)</strong></td>
                            <td id="finalDist" class="text-muted">-</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div id="cameraError" class="alert alert-warning mt-2" style="display: none;">
        카메라 연결이 끊어졌습니다. 재연결을 시도하고 있습니다...
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var $badge = $('#camBadge');
            var $error = $('#cameraError');
            var $rgbFeed = $('#rgbFeed');
            var $depthFeed = $('#depthFeed');
            var wasConnected = @(Model.IsConnected ? "true" : "false");

            function checkStatus() {
                $.getJSON('/Camera?handler=Status', function (data) {
                    if (data.connected) {
                        $badge.removeClass('bg-secondary bg-danger').addClass('bg-success').text('Camera: 연결됨');
                        $error.hide();
                        if (!wasConnected) {
                            $rgbFeed.attr('src', '/Camera?handler=RgbStream&t=' + Date.now());
                            $depthFeed.attr('src', '/Camera?handler=DepthStream&t=' + Date.now());
                        }
                        wasConnected = true;
                        // Depth 패널 표시/숨김
                        if (data.hasDepth) {
                            $('#depthPanel').show();
                        } else {
                            $('#depthPanel').hide();
                        }
                    } else {
                        $badge.removeClass('bg-success bg-secondary').addClass('bg-danger').text('Camera: 연결 끊김');
                        $error.show();
                        wasConnected = false;
                    }
                }).fail(function () {
                    $badge.removeClass('bg-success bg-secondary').addClass('bg-danger').text('Camera: 오류');
                });
            }

            setInterval(checkStatus, 3000);

            // 카메라 스캔
            $('#btnScanCameras').on('click', function () {
                var $btn = $(this);
                $btn.prop('disabled', true);
                $('#scanSpinner').show();
                $.getJSON('/Camera?handler=EnumerateCameras', function (data) {
                    var $sel = $('#cameraSelect');
                    $sel.empty();
                    if (data.length === 0) {
                        $sel.append('<option value="">카메라를 찾을 수 없음</option>');
                    } else {
                        $.each(data, function (i, cam) {
                            $sel.append('<option value="' + cam.index + '">' + cam.label + '</option>');
                        });
                    }
                }).always(function () {
                    $btn.prop('disabled', false);
                    $('#scanSpinner').hide();
                });
            });

            // 카메라 전환
            $('#btnOpenCamera').on('click', function () {
                var idx = $('#cameraSelect').val();
                if (idx === '' || idx === null) return;
                var backend = $('#backendSelect').val();
                var $btn = $(this);
                $btn.prop('disabled', true).text('전환 중...');
                $.post('/Camera?handler=SwitchCamera', {
                    deviceIndex: parseInt(idx),
                    backend: backend
                }, function (res) {
                    if (res.success) {
                        wasConnected = false;
                        setTimeout(function () {
                            $rgbFeed.attr('src', '/Camera?handler=RgbStream&t=' + Date.now());
                            $depthFeed.attr('src', '/Camera?handler=DepthStream&t=' + Date.now());
                        }, 1500);
                    }
                }).always(function () {
                    $btn.prop('disabled', false).text('열기');
                });
            });

            $rgbFeed.on('error', function () {
                setTimeout(function () {
                    $rgbFeed.attr('src', '/Camera?handler=RgbStream&t=' + Date.now());
                }, 3000);
            });

            $depthFeed.on('error', function () {
                setTimeout(function () {
                    $depthFeed.attr('src', '/Camera?handler=DepthStream&t=' + Date.now());
                }, 3000);
            });

            // QR 코드 감지 상태 폴링
            var $qrBadge = $('#qrBadge');
            var $qrText = $('#qrText');
            var $qrCenter = $('#qrCenter');
            var $qrAngle = $('#qrAngle');
            var $frameCenter = $('#frameCenter');
            var $qrDelta = $('#qrDelta');
            var $qrTime = $('#qrTime');
            var $finalCoord = $('#finalCoord');
            var $finalAngle = $('#finalAngle');
            var $finalDist = $('#finalDist');

            function checkQrStatus() {
                $.getJSON('/Camera?handler=QrStatus', function (data) {
                    if (data.detected) {
                        $qrBadge.removeClass('bg-secondary').addClass('bg-success').text('감지됨');
                        $qrText.removeClass('text-muted').text(data.decodedText);
                        $qrCenter.removeClass('text-muted').text('X: ' + data.centerX + ',  Y: ' + data.centerY);
                        $qrAngle.removeClass('text-muted').text(data.rotationAngle + '\u00B0');
                        $frameCenter.removeClass('text-muted').text('X: ' + data.frameCenterX + ',  Y: ' + data.frameCenterY);
                        $qrDelta.removeClass('text-muted').text('dX: ' + data.deltaX + ',  dY: ' + data.deltaY);
                        $qrTime.removeClass('text-muted').text(data.detectedAt);

                        // Offset 적용하여 최종 이동 좌표 계산
                        var offX = parseFloat($('#offsetX').val()) || 0;
                        var offY = parseFloat($('#offsetY').val()) || 0;
                        var offAngle = parseFloat($('#offsetAngle').val()) || 0;

                        var finalX = data.deltaX + offX;
                        var finalY = data.deltaY + offY;
                        var finalA = data.rotationAngle + offAngle;
                        var dist = Math.sqrt(finalX * finalX + finalY * finalY);

                        $finalCoord.removeClass('text-muted').text('X: ' + finalX.toFixed(1) + ',  Y: ' + finalY.toFixed(1));
                        $finalAngle.removeClass('text-muted').text(finalA.toFixed(1) + '\u00B0');
                        $finalDist.removeClass('text-muted').text(dist.toFixed(1));
                    } else {
                        $qrBadge.removeClass('bg-success').addClass('bg-secondary').text('감지 안됨');
                        $qrText.addClass('text-muted').text('-');
                        $qrCenter.addClass('text-muted').text('-');
                        $qrAngle.addClass('text-muted').text('-');
                        $frameCenter.addClass('text-muted').text('-');
                        $qrDelta.addClass('text-muted').text('-');
                        $qrTime.addClass('text-muted').text('-');
                        $finalCoord.addClass('text-muted').text('-');
                        $finalAngle.addClass('text-muted').text('-');
                        $finalDist.addClass('text-muted').text('-');
                    }
                });
            }

            setInterval(checkQrStatus, 500);
        });
    </script>
}
