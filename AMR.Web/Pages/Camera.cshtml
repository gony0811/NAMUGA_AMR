@page
@model AMR.Web.Pages.CameraModel
@{
    ViewData["Title"] = "Camera";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Camera</h4>
        <span id="camBadge" class="badge @(Model.IsConnected ? "bg-success" : "bg-secondary")">
            Camera: @(Model.IsConnected ? "연결됨" : "확인 중...")
        </span>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header py-2">
                    <strong>RGB Camera</strong>
                </div>
                <div class="card-body text-center p-2">
                    <img id="rgbFeed" src="/Camera?handler=RgbStream"
                         style="max-width: 100%; height: auto; border: 1px solid #ddd; background: #000;"
                         alt="RGB Camera Feed" />
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header py-2">
                    <strong>Depth Camera</strong>
                </div>
                <div class="card-body text-center p-2">
                    <img id="depthFeed" src="/Camera?handler=DepthStream"
                         style="max-width: 100%; height: auto; border: 1px solid #ddd; background: #000;"
                         alt="Depth Camera Feed" />
                </div>
            </div>
        </div>
    </div>

    <div id="cameraError" class="alert alert-warning mt-2" style="display: none;">
        카메라 연결이 끊어졌습니다. 재연결을 시도하고 있습니다...
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var $badge = $('#camBadge');
            var $error = $('#cameraError');
            var $rgbFeed = $('#rgbFeed');
            var $depthFeed = $('#depthFeed');
            var wasConnected = @(Model.IsConnected ? "true" : "false");

            function checkStatus() {
                $.getJSON('/Camera?handler=Status', function (data) {
                    if (data.connected) {
                        $badge.removeClass('bg-secondary bg-danger').addClass('bg-success').text('Camera: 연결됨');
                        $error.hide();
                        if (!wasConnected) {
                            $rgbFeed.attr('src', '/Camera?handler=RgbStream&t=' + Date.now());
                            $depthFeed.attr('src', '/Camera?handler=DepthStream&t=' + Date.now());
                        }
                        wasConnected = true;
                    } else {
                        $badge.removeClass('bg-success bg-secondary').addClass('bg-danger').text('Camera: 연결 끊김');
                        $error.show();
                        wasConnected = false;
                    }
                }).fail(function () {
                    $badge.removeClass('bg-success bg-secondary').addClass('bg-danger').text('Camera: 오류');
                });
            }

            setInterval(checkStatus, 3000);

            $rgbFeed.on('error', function () {
                setTimeout(function () {
                    $rgbFeed.attr('src', '/Camera?handler=RgbStream&t=' + Date.now());
                }, 3000);
            });

            $depthFeed.on('error', function () {
                setTimeout(function () {
                    $depthFeed.attr('src', '/Camera?handler=DepthStream&t=' + Date.now());
                }, 3000);
            });
        });
    </script>
}
