@page
@model AMR.Web.Pages.CameraModel
@{
    ViewData["Title"] = "Camera";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Camera</h4>
        <span id="camBadge" class="badge @(Model.IsConnected ? "bg-success" : "bg-secondary")">
            Camera: @(Model.IsConnected ? "연결됨" : "확인 중...")
        </span>
    </div>

    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label form-label-sm mb-0"><strong>카메라</strong></label>
                    <select id="cameraSelect" class="form-select form-select-sm" style="min-width: 220px;">
                        <option value="">-- 스캔하세요 --</option>
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label form-label-sm mb-0"><strong>백엔드</strong></label>
                    <select id="backendSelect" class="form-select form-select-sm">
                        <option value="any">일반 (USB)</option>
                        <option value="obsensor">OBSENSOR (Orbbec)</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button id="btnScanCameras" class="btn btn-sm btn-outline-secondary">
                        카메라 스캔
                    </button>
                </div>
                <div class="col-auto">
                    <button id="btnOpenCamera" class="btn btn-sm btn-primary">
                        열기
                    </button>
                </div>
                <div class="col-auto">
                    <span id="scanSpinner" class="spinner-border spinner-border-sm text-secondary" style="display:none;"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header py-2">
                    <strong>RGB Camera</strong>
                </div>
                <div class="card-body text-center p-2">
                    <img id="rgbFeed" src="/Camera?handler=RgbStream"
                         style="max-width: 100%; height: auto; border: 1px solid #ddd; background: #000;"
                         alt="RGB Camera Feed" />
                </div>
            </div>
        </div>
        <div class="col-md-6" id="depthPanel">
            <div class="card">
                <div class="card-header py-2">
                    <strong>Depth Camera</strong>
                </div>
                <div class="card-body text-center p-2">
                    <div id="depthWrapper"
                         style="position: relative; display: inline-block; max-width: 100%; cursor: crosshair; user-select: none;">
                        <img id="depthFeed" src="/Camera?handler=DepthStream"
                             draggable="false"
                             style="max-width: 100%; height: auto; border: 1px solid #ddd; background: #000; display: block; -webkit-user-drag: none;"
                             alt="Depth Camera Feed" />
                        <!-- 매거진 감지 ROI 오버레이 (저장된 ROI — 빨간 박스) -->
                        <div id="magRoiOverlay"
                             style="position: absolute; border: 2px solid #ff3b30; pointer-events: none; display: none;
                                    box-shadow: 0 0 0 1px rgba(0,0,0,0.4); box-sizing: border-box;"></div>
                        <!-- 드래그 중 미리보기 박스 (실선/노란색) -->
                        <div id="magRoiDragPreview"
                             style="position: absolute; border: 2px dashed #ffd60a; pointer-events: none; display: none;
                                    background: rgba(255, 214, 10, 0.15); box-sizing: border-box;"></div>
                    </div>
                    <div class="small text-muted mt-1">
                        💡 영상 위에서 <strong>드래그</strong> 해서 ROI 선택 (드래그 완료 후 "저장" 클릭)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                    <strong>QR Code Detection</strong>
                    <span id="qrBadge" class="badge bg-secondary">감지 안됨</span>
                </div>
                <div class="card-body py-2">
                    <table class="table table-sm table-borderless mb-0">
                        <tr>
                            <td style="width: 140px;"><strong>내용</strong></td>
                            <td id="qrText" class="text-muted">-</td>
                        </tr>
                        <tr>
                            <td><strong>QR 중심 (px)</strong></td>
                            <td id="qrCenter" class="text-muted">-</td>
                        </tr>
                        <tr>
                            <td><strong>회전 각도</strong></td>
                            <td id="qrAngle" class="text-muted">-</td>
                        </tr>
                        <tr>
                            <td><strong>카메라 중심 (px)</strong></td>
                            <td id="frameCenter" class="text-muted">-</td>
                        </tr>
                        <tr>
                            <td><strong>Delta (px)</strong></td>
                            <td id="qrDelta" class="text-muted">-</td>
                        </tr>
                        <tr class="table-info">
                            <td><strong>Depth (mm)</strong></td>
                            <td id="qrDepth" class="text-muted">-</td>
                        </tr>
                        <tr class="table-info">
                            <td><strong>Real Delta (mm)</strong></td>
                            <td id="qrRealDelta" class="text-muted">-</td>
                        </tr>
                        <tr class="table-info">
                            <td><strong>Real Distance (mm)</strong></td>
                            <td id="qrRealDist" class="text-muted">-</td>
                        </tr>
                        <tr>
                            <td><strong>감지 시각</strong></td>
                            <td id="qrTime" class="text-muted">-</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                    <strong>QR Teaching Position</strong>
                    <span id="teachBadge" class="badge bg-secondary">미설정</span>
                </div>
                <div class="card-body py-2">
                    <div class="d-flex gap-2 mb-2">
                        <button id="btnSaveTeaching" class="btn btn-sm btn-primary">Teaching 저장</button>
                        <button id="btnClearTeaching" class="btn btn-sm btn-outline-danger">초기화</button>
                    </div>
                    <div id="teachError" class="alert alert-danger py-1 mb-2 small" style="display:none;"></div>

                    <table class="table table-sm table-borderless mb-0">
                        <thead>
                            <tr class="table-light">
                                <td style="width: 140px;"></td>
                                <td><strong>X (mm)</strong></td>
                                <td><strong>Y (mm)</strong></td>
                                <td><strong>Depth (mm)</strong></td>
                                <td><strong>Angle (&deg;)</strong></td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="table-success">
                                <td><strong>Teaching</strong></td>
                                <td id="teachX" class="text-muted">-</td>
                                <td id="teachY" class="text-muted">-</td>
                                <td id="teachDepth" class="text-muted">-</td>
                                <td id="teachAngle" class="text-muted">-</td>
                            </tr>
                            <tr>
                                <td><strong>Current</strong></td>
                                <td id="curX" class="text-muted">-</td>
                                <td id="curY" class="text-muted">-</td>
                                <td id="curDepth" class="text-muted">-</td>
                                <td id="curAngle" class="text-muted">-</td>
                            </tr>
                            <tr class="table-warning">
                                <td><strong>Offset (Cobot 보정)</strong></td>
                                <td id="offX" class="text-muted">-</td>
                                <td id="offY" class="text-muted">-</td>
                                <td id="offDepth" class="text-muted">-</td>
                                <td id="offAngle" class="text-muted">-</td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="small text-muted mt-1">
                        <span id="teachQrText"></span>
                        <span id="teachTime"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                    <strong>매거진 감지 (Depth 기반)</strong>
                    <span id="magBadge" class="badge bg-secondary">미감지</span>
                </div>
                <div class="card-body py-2">
                    <div class="row g-2 align-items-end">
                        <div class="col-auto">
                            <label class="form-label form-label-sm mb-0">ROI X</label>
                            <input type="number" id="magRoiX" class="form-control form-control-sm" style="width:90px;" min="0" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label form-label-sm mb-0">ROI Y</label>
                            <input type="number" id="magRoiY" class="form-control form-control-sm" style="width:90px;" min="0" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label form-label-sm mb-0">ROI W</label>
                            <input type="number" id="magRoiW" class="form-control form-control-sm" style="width:90px;" min="1" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label form-label-sm mb-0">ROI H</label>
                            <input type="number" id="magRoiH" class="form-control form-control-sm" style="width:90px;" min="1" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label form-label-sm mb-0">Depth Min (mm)</label>
                            <input type="number" id="magDepthMin" class="form-control form-control-sm" style="width:110px;" min="0" max="10000" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label form-label-sm mb-0">Depth Max (mm)</label>
                            <input type="number" id="magDepthMax" class="form-control form-control-sm" style="width:110px;" min="1" max="10000" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label form-label-sm mb-0">Threshold (0~1)</label>
                            <input type="number" id="magThresh" class="form-control form-control-sm" style="width:100px;" step="0.05" min="0" max="1" />
                        </div>
                        <div class="col-auto">
                            <button id="btnSaveMagSettings" class="btn btn-sm btn-primary">저장</button>
                        </div>
                        <div class="col-auto">
                            <button id="btnTestMagDetect" class="btn btn-sm btn-outline-info">지금 테스트</button>
                        </div>
                    </div>

                    <div class="small text-muted mt-2">
                        Depth 프레임 해상도: <span id="magDepthRes">-</span> &nbsp;|&nbsp;
                        ROI 미리보기는 Depth Camera 영상 위에 빨간 박스로 표시됩니다.
                    </div>

                    <table class="table table-sm table-borderless mt-2 mb-0">
                        <tbody>
                            <tr>
                                <td style="width:160px;"><strong>판정</strong></td>
                                <td><span id="magDetected" class="badge bg-secondary">-</span></td>
                            </tr>
                            <tr>
                                <td><strong>In-range 비율</strong></td>
                                <td id="magRatio" class="text-muted">-</td>
                            </tr>
                            <tr>
                                <td><strong>유효 depth 비율</strong></td>
                                <td id="magCoverage" class="text-muted">-</td>
                            </tr>
                            <tr>
                                <td><strong>평균 depth (mm)</strong></td>
                                <td id="magAvgDepth" class="text-muted">-</td>
                            </tr>
                            <tr>
                                <td><strong>픽셀 수</strong></td>
                                <td id="magPixels" class="text-muted">-</td>
                            </tr>
                            <tr>
                                <td><strong>사유</strong></td>
                                <td id="magReason" class="text-muted small">-</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div id="cameraError" class="alert alert-warning mt-2" style="display: none;">
        카메라 연결이 끊어졌습니다. 재연결을 시도하고 있습니다...
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var $badge = $('#camBadge');
            var $error = $('#cameraError');
            var $rgbFeed = $('#rgbFeed');
            var $depthFeed = $('#depthFeed');
            var wasConnected = @(Model.IsConnected ? "true" : "false");

            function checkStatus() {
                $.getJSON('/Camera?handler=Status', function (data) {
                    if (data.connected) {
                        $badge.removeClass('bg-secondary bg-danger').addClass('bg-success').text('Camera: 연결됨');
                        $error.hide();
                        if (!wasConnected) {
                            $rgbFeed.attr('src', '/Camera?handler=RgbStream&t=' + Date.now());
                            $depthFeed.attr('src', '/Camera?handler=DepthStream&t=' + Date.now());
                        }
                        wasConnected = true;
                        // Depth 패널 표시/숨김
                        if (data.hasDepth) {
                            $('#depthPanel').show();
                        } else {
                            $('#depthPanel').hide();
                        }
                    } else {
                        $badge.removeClass('bg-success bg-secondary').addClass('bg-danger').text('Camera: 연결 끊김');
                        $error.show();
                        wasConnected = false;
                    }
                }).fail(function () {
                    $badge.removeClass('bg-success bg-secondary').addClass('bg-danger').text('Camera: 오류');
                });
            }

            setInterval(checkStatus, 3000);

            // 카메라 스캔
            $('#btnScanCameras').on('click', function () {
                var $btn = $(this);
                $btn.prop('disabled', true);
                $('#scanSpinner').show();
                $.getJSON('/Camera?handler=EnumerateCameras', function (data) {
                    var $sel = $('#cameraSelect');
                    $sel.empty();
                    if (data.length === 0) {
                        $sel.append('<option value="">카메라를 찾을 수 없음</option>');
                    } else {
                        $.each(data, function (i, cam) {
                            $sel.append('<option value="' + cam.index + '">' + cam.label + '</option>');
                        });
                    }
                }).always(function () {
                    $btn.prop('disabled', false);
                    $('#scanSpinner').hide();
                });
            });

            // 카메라 전환
            $('#btnOpenCamera').on('click', function () {
                var idx = $('#cameraSelect').val();
                if (idx === '' || idx === null) return;
                var backend = $('#backendSelect').val();
                var $btn = $(this);
                $btn.prop('disabled', true).text('전환 중...');
                $.post('/Camera?handler=SwitchCamera', {
                    deviceIndex: parseInt(idx),
                    backend: backend
                }, function (res) {
                    if (res.success) {
                        wasConnected = false;
                        setTimeout(function () {
                            $rgbFeed.attr('src', '/Camera?handler=RgbStream&t=' + Date.now());
                            $depthFeed.attr('src', '/Camera?handler=DepthStream&t=' + Date.now());
                        }, 1500);
                    }
                }).always(function () {
                    $btn.prop('disabled', false).text('열기');
                });
            });

            $rgbFeed.on('error', function () {
                setTimeout(function () {
                    $rgbFeed.attr('src', '/Camera?handler=RgbStream&t=' + Date.now());
                }, 3000);
            });

            $depthFeed.on('error', function () {
                setTimeout(function () {
                    $depthFeed.attr('src', '/Camera?handler=DepthStream&t=' + Date.now());
                }, 3000);
            });

            // QR 코드 감지 상태 폴링
            var $qrBadge = $('#qrBadge');
            var $qrText = $('#qrText');
            var $qrCenter = $('#qrCenter');
            var $qrAngle = $('#qrAngle');
            var $frameCenter = $('#frameCenter');
            var $qrDelta = $('#qrDelta');
            var $qrDepth = $('#qrDepth');
            var $qrRealDelta = $('#qrRealDelta');
            var $qrRealDist = $('#qrRealDist');
            var $qrTime = $('#qrTime');

            function checkQrStatus() {
                $.getJSON('/Camera?handler=QrStatus', function (data) {
                    if (data.detected) {
                        $qrBadge.removeClass('bg-secondary').addClass('bg-success').text('감지됨');
                        $qrText.removeClass('text-muted').text(data.decodedText);
                        $qrCenter.removeClass('text-muted').text('X: ' + data.centerX + ',  Y: ' + data.centerY);
                        $qrAngle.removeClass('text-muted').text(data.rotationAngle + '\u00B0');
                        $frameCenter.removeClass('text-muted').text('X: ' + data.frameCenterX + ',  Y: ' + data.frameCenterY);
                        $qrDelta.removeClass('text-muted').text('dX: ' + data.deltaX + ',  dY: ' + data.deltaY);
                        $qrDepth.removeClass('text-muted').text(data.depthMm > 0 ? data.depthMm.toFixed(1) : 'N/A');
                        $qrRealDelta.removeClass('text-muted').text(data.depthMm > 0
                            ? 'dX: ' + data.realDeltaXMm.toFixed(1) + ',  dY: ' + data.realDeltaYMm.toFixed(1)
                            : 'N/A (Depth 필요)');
                        $qrRealDist.removeClass('text-muted').text(data.depthMm > 0
                            ? data.realDistanceMm.toFixed(1)
                            : 'N/A');
                        $qrTime.removeClass('text-muted').text(data.detectedAt);
                    } else {
                        $qrBadge.removeClass('bg-success').addClass('bg-secondary').text('감지 안됨');
                        $qrText.addClass('text-muted').text('-');
                        $qrCenter.addClass('text-muted').text('-');
                        $qrAngle.addClass('text-muted').text('-');
                        $frameCenter.addClass('text-muted').text('-');
                        $qrDelta.addClass('text-muted').text('-');
                        $qrDepth.addClass('text-muted').text('-');
                        $qrRealDelta.addClass('text-muted').text('-');
                        $qrRealDist.addClass('text-muted').text('-');
                        $qrTime.addClass('text-muted').text('-');
                    }
                });
            }

            setInterval(checkQrStatus, 500);

            // ── Teaching Position ──
            var $teachBadge = $('#teachBadge');

            $('#btnSaveTeaching').on('click', function () {
                var $btn = $(this);
                $btn.prop('disabled', true);
                $('#teachError').hide();
                $.post('/Camera?handler=SaveTeaching', {}, function (res) {
                    if (res.success) {
                        updateTeachingDisplay(res);
                        $teachBadge.removeClass('bg-secondary').addClass('bg-success').text('Teaching 완료');
                    } else {
                        $('#teachError').text(res.error).show();
                    }
                }).fail(function () {
                    $('#teachError').text('요청 실패').show();
                }).always(function () {
                    $btn.prop('disabled', false);
                });
            });

            $('#btnClearTeaching').on('click', function () {
                $.post('/Camera?handler=ClearTeaching', {}, function () {
                    $('#teachX, #teachY, #teachDepth, #teachAngle').addClass('text-muted').text('-');
                    $('#curX, #curY, #curDepth, #curAngle').addClass('text-muted').text('-');
                    $('#offX, #offY, #offDepth, #offAngle').addClass('text-muted').text('-');
                    $('#teachQrText, #teachTime').text('');
                    $teachBadge.removeClass('bg-success').addClass('bg-secondary').text('미설정');
                });
            });

            function updateTeachingDisplay(t) {
                $('#teachX').removeClass('text-muted').text(t.x.toFixed(1));
                $('#teachY').removeClass('text-muted').text(t.y.toFixed(1));
                $('#teachDepth').removeClass('text-muted').text(t.depthMm.toFixed(1));
                $('#teachAngle').removeClass('text-muted').text(t.angle.toFixed(1));
                $('#teachQrText').text('QR: ' + t.qrText);
                $('#teachTime').text('  |  ' + t.taughtAt);
            }

            function checkTeachingStatus() {
                $.getJSON('/Camera?handler=TeachingStatus', function (data) {
                    var t = data.teaching;
                    var o = data.offset;

                    if (t.isTaught) {
                        $teachBadge.removeClass('bg-secondary').addClass('bg-success').text('Teaching 완료');
                        $('#teachX').removeClass('text-muted').text(t.x.toFixed(1));
                        $('#teachY').removeClass('text-muted').text(t.y.toFixed(1));
                        $('#teachDepth').removeClass('text-muted').text(t.depthMm.toFixed(1));
                        $('#teachAngle').removeClass('text-muted').text(t.angle.toFixed(1));
                        $('#teachQrText').text('QR: ' + t.qrText);
                        $('#teachTime').text('  |  ' + t.taughtAt);
                    }

                    if (o.hasCurrent) {
                        var qr = lastQrData;
                        if (qr) {
                            $('#curX').removeClass('text-muted').text(qr.realDeltaXMm.toFixed(1));
                            $('#curY').removeClass('text-muted').text(qr.realDeltaYMm.toFixed(1));
                            $('#curDepth').removeClass('text-muted').text(qr.depthMm.toFixed(1));
                            $('#curAngle').removeClass('text-muted').text(qr.rotationAngle.toFixed(1));
                        }
                    } else {
                        $('#curX, #curY, #curDepth, #curAngle').addClass('text-muted').text('-');
                    }

                    if (o.hasTeaching && o.hasCurrent) {
                        $('#offX').removeClass('text-muted').text(o.offsetXMm.toFixed(1));
                        $('#offY').removeClass('text-muted').text(o.offsetYMm.toFixed(1));
                        $('#offDepth').removeClass('text-muted').text(o.offsetDepthMm.toFixed(1));
                        $('#offAngle').removeClass('text-muted').text(o.offsetAngle.toFixed(1));
                    } else {
                        $('#offX, #offY, #offDepth, #offAngle').addClass('text-muted').text('-');
                    }
                });
            }

            var lastQrData = null;
            // QR 데이터를 Teaching 폴링에서도 참조할 수 있도록 저장
            $(document).ajaxComplete(function (e, xhr, settings) {
                if (settings.url && settings.url.indexOf('handler=QrStatus') >= 0) {
                    try { lastQrData = JSON.parse(xhr.responseText); } catch (_) {}
                }
            });

            setInterval(checkTeachingStatus, 500);

            // ─────── 매거진 감지 (depth) ───────
            var magDepthFrameW = 640;
            var magDepthFrameH = 480;

            function updateRoiOverlay() {
                var $img = $('#depthFeed');
                var $ovl = $('#magRoiOverlay');
                if (!$img.length || !$img[0].complete || $img[0].naturalWidth === 0 || magDepthFrameW === 0) {
                    $ovl.hide();
                    return;
                }
                // 표시된 영상 크기 (CSS 픽셀) — naturalWidth 는 송출된 JPEG 원본 크기
                var dispW = $img[0].clientWidth;
                var dispH = $img[0].clientHeight;
                if (dispW === 0 || dispH === 0) { $ovl.hide(); return; }

                // 입력된 ROI 는 depth frame 좌표계(640x480 등). 표시 영상은 같은 비율로 스케일.
                var scaleX = dispW / magDepthFrameW;
                var scaleY = dispH / magDepthFrameH;

                var rx = parseInt($('#magRoiX').val()) || 0;
                var ry = parseInt($('#magRoiY').val()) || 0;
                var rw = parseInt($('#magRoiW').val()) || 0;
                var rh = parseInt($('#magRoiH').val()) || 0;

                $ovl.css({
                    left:   (rx * scaleX) + 'px',
                    top:    (ry * scaleY) + 'px',
                    width:  (rw * scaleX) + 'px',
                    height: (rh * scaleY) + 'px',
                    display: 'block'
                });
            }

            function loadMagSettings() {
                $.getJSON('/Camera?handler=MagazineSettings', function (s) {
                    $('#magRoiX').val(s.roiX);
                    $('#magRoiY').val(s.roiY);
                    $('#magRoiW').val(s.roiWidth);
                    $('#magRoiH').val(s.roiHeight);
                    $('#magDepthMin').val(s.depthMinMm);
                    $('#magDepthMax').val(s.depthMaxMm);
                    $('#magThresh').val(s.threshold);
                    if (s.depthFrameWidth > 0 && s.depthFrameHeight > 0) {
                        magDepthFrameW = s.depthFrameWidth;
                        magDepthFrameH = s.depthFrameHeight;
                    }
                    $('#magDepthRes').text(magDepthFrameW + ' x ' + magDepthFrameH);
                    updateRoiOverlay();
                });
            }

            $('#btnSaveMagSettings').on('click', function () {
                var payload = {
                    roiX:       parseInt($('#magRoiX').val()) || 0,
                    roiY:       parseInt($('#magRoiY').val()) || 0,
                    roiWidth:   parseInt($('#magRoiW').val()) || 1,
                    roiHeight:  parseInt($('#magRoiH').val()) || 1,
                    depthMinMm: parseInt($('#magDepthMin').val()) || 0,
                    depthMaxMm: parseInt($('#magDepthMax').val()) || 1,
                    threshold:  parseFloat($('#magThresh').val()) || 0
                };
                var $btn = $(this).prop('disabled', true);
                $.ajax({
                    url: '/Camera?handler=UpdateMagazineSettings',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (s) {
                        // 서버가 clamping 한 값으로 다시 표시
                        $('#magRoiX').val(s.roiX);
                        $('#magRoiY').val(s.roiY);
                        $('#magRoiW').val(s.roiWidth);
                        $('#magRoiH').val(s.roiHeight);
                        $('#magDepthMin').val(s.depthMinMm);
                        $('#magDepthMax').val(s.depthMaxMm);
                        $('#magThresh').val(s.threshold);
                        updateRoiOverlay();
                    }
                }).always(function () { $btn.prop('disabled', false); });
            });

            $('#btnTestMagDetect').on('click', function () {
                var $btn = $(this).prop('disabled', true);
                $.getJSON('/Camera?handler=TestMagazineDetection', function (r) {
                    $('#magDetected')
                        .removeClass('bg-secondary bg-success bg-danger')
                        .addClass(r.detected ? 'bg-success' : 'bg-danger')
                        .text(r.detected ? '매거진 있음' : '매거진 없음');
                    $('#magBadge')
                        .removeClass('bg-secondary bg-success bg-danger')
                        .addClass(r.detected ? 'bg-success' : 'bg-danger')
                        .text(r.detected ? '있음' : '없음');
                    $('#magRatio').text((r.validPixelRatio * 100).toFixed(1) + '% (' + r.inRangePixels + ' / ' + r.totalPixels + ')');
                    $('#magCoverage').text((r.validDepthCoverage * 100).toFixed(1) + '%');
                    $('#magAvgDepth').text(r.averageDepthMm + ' mm');
                    $('#magPixels').text(r.totalPixels + ' px');
                    $('#magReason').text(r.reason);
                }).always(function () { $btn.prop('disabled', false); });
            });

            // ROI 입력값 바뀔 때마다 오버레이 갱신 (저장 안 해도 미리보기)
            $('#magRoiX, #magRoiY, #magRoiW, #magRoiH').on('input change', updateRoiOverlay);

            // depth 영상 크기 변경(창 리사이즈) 시 오버레이 재계산
            $(window).on('resize', updateRoiOverlay);
            $('#depthFeed').on('load', updateRoiOverlay);

            // ───── Depth 영상 드래그로 ROI 선택 ─────
            var roiDragging = false;
            var roiDragStart = null;

            function getRelativePoint(evt) {
                var wrapper = document.getElementById('depthWrapper');
                if (!wrapper) return null;
                var rect = wrapper.getBoundingClientRect();
                var img = document.getElementById('depthFeed');
                var dispW = img.clientWidth || rect.width;
                var dispH = img.clientHeight || rect.height;
                var x = evt.clientX - rect.left;
                var y = evt.clientY - rect.top;
                // 영상 영역 밖으로 나가도 영상 경계로 클램프
                x = Math.max(0, Math.min(x, dispW));
                y = Math.max(0, Math.min(y, dispH));
                return { x: x, y: y, dispW: dispW, dispH: dispH };
            }

            $('#depthWrapper').on('mousedown', function (e) {
                if (e.which !== 1) return;   // 좌클릭만
                var p = getRelativePoint(e);
                if (!p) return;
                roiDragging = true;
                roiDragStart = p;
                // 드래그 시작 시 미리보기 박스 표시 (크기 0 으로 시작)
                $('#magRoiDragPreview').css({
                    left: p.x + 'px', top: p.y + 'px',
                    width: '0px', height: '0px', display: 'block'
                });
                e.preventDefault();
            });

            $(document).on('mousemove.magroi', function (e) {
                if (!roiDragging || !roiDragStart) return;
                var p = getRelativePoint(e);
                if (!p) return;
                var left = Math.min(roiDragStart.x, p.x);
                var top  = Math.min(roiDragStart.y, p.y);
                var w = Math.abs(p.x - roiDragStart.x);
                var h = Math.abs(p.y - roiDragStart.y);
                $('#magRoiDragPreview').css({
                    left: left + 'px', top: top + 'px',
                    width: w + 'px', height: h + 'px'
                });
            });

            $(document).on('mouseup.magroi', function (e) {
                if (!roiDragging || !roiDragStart) return;
                roiDragging = false;
                $('#magRoiDragPreview').hide();

                var p = getRelativePoint(e);
                if (!p) { roiDragStart = null; return; }
                var left = Math.min(roiDragStart.x, p.x);
                var top  = Math.min(roiDragStart.y, p.y);
                var w = Math.abs(p.x - roiDragStart.x);
                var h = Math.abs(p.y - roiDragStart.y);
                roiDragStart = null;

                // 너무 작은 드래그(클릭에 가까움) 무시
                if (w < 5 || h < 5) {
                    updateRoiOverlay();
                    return;
                }

                // 표시 좌표 → depth frame 좌표 변환
                var scaleX = magDepthFrameW / p.dispW;
                var scaleY = magDepthFrameH / p.dispH;
                var depthX = Math.round(left * scaleX);
                var depthY = Math.round(top * scaleY);
                var depthW2 = Math.round(w * scaleX);
                var depthH2 = Math.round(h * scaleY);

                // 입력 필드 갱신 → 빨간 박스(저장된 ROI) 도 갱신
                $('#magRoiX').val(depthX);
                $('#magRoiY').val(depthY);
                $('#magRoiW').val(depthW2);
                $('#magRoiH').val(depthH2);
                updateRoiOverlay();
            });

            // 마우스가 창 밖으로 나가면 드래그 취소
            $(document).on('mouseleave.magroi', function () {
                if (roiDragging) {
                    roiDragging = false;
                    roiDragStart = null;
                    $('#magRoiDragPreview').hide();
                    updateRoiOverlay();
                }
            });

            loadMagSettings();
        });
    </script>
}
