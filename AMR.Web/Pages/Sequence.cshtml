@page
@model AMR.Web.Pages.SequenceModel
@{
    ViewData["Title"] = "Sequence";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Sequence Test</h2>
        <span id="seqStatus" class="badge bg-secondary">Idle</span>
    </div>
    <hr />

    <div class="row">
        @* ── 왼쪽: 시퀀스 제어 + 진행 상태 ── *@
        <div class="col-lg-5 mb-3">
            @* 시뮬레이션 모드 (사무실 테스트) *@
            <div class="card mb-3 border-info">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">🖥️ 시뮬레이션 모드 (사무실 테스트)</h5>
                    <span id="simBadge" class="badge bg-secondary">OFF</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-2">
                        실장비 없이 시퀀스 검증 — AMR 이동·Cobot 동작이 아래 <strong>동작 완료</strong> 버튼 대기로
                        바뀌고, 카메라 QR 은 생략, 슬롯 센서는 가상 상태를 사용합니다.
                    </p>
                    <div class="d-flex gap-2 mb-2">
                        <button id="btnSimOn" class="btn btn-info btn-sm flex-fill" onclick="simToggle(true)">모드 ON</button>
                        <button id="btnSimOff" class="btn btn-outline-secondary btn-sm flex-fill" onclick="simToggle(false)">모드 OFF</button>
                    </div>

                    @* 대기 중 동작 + 확인 버튼 *@
                    <div id="simPendingBox" class="alert alert-warning py-2 px-2 mb-2 d-none">
                        <div class="small mb-1">⏳ 동작 대기 중:</div>
                        <div id="simPendingAction" class="fw-bold small mb-2">-</div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-success btn-sm flex-fill" onclick="simConfirm()">
                                <i class="bi bi-check-lg"></i> 동작 완료
                            </button>
                            <button class="btn btn-outline-danger btn-sm" onclick="simFail()">실패 주입</button>
                        </div>
                    </div>
                    <div id="simIdleBox" class="text-muted small mb-2">대기 중인 동작 없음</div>

                    @* 가상 슬롯 상태 *@
                    <div class="small fw-bold mb-1">가상 센서 상태 (클릭으로 토글)</div>
                    <div class="d-flex gap-1 mb-1">
                        <span class="small text-muted me-1" style="width:70px">AMR 슬롯:</span>
                        <button id="simAmr1" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="simToggleSlot('amr1')">1</button>
                        <button id="simAmr2" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="simToggleSlot('amr2')">2</button>
                        <button id="simAmr3" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="simToggleSlot('amr3')">3</button>
                        <button id="simAmr4" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="simToggleSlot('amr4')">4</button>
                    </div>
                    <div class="d-flex gap-1">
                        <span class="small text-muted me-1" style="width:70px">자재포트:</span>
                        <button id="simMat1" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="simToggleSlot('mat1')">slot1</button>
                        <button id="simMat2" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="simToggleSlot('mat2')">slot2</button>
                    </div>
                    <div class="text-muted mt-1" style="font-size:0.72rem">
                        초록=매거진 있음, 회색=빈 슬롯. Pick/Place 완료 시 자동 갱신됩니다.
                    </div>

                    @* 가상 AMR 좌표 (status pose 로 ACS 에 발행) *@
                    <div class="small fw-bold mt-2 mb-1">가상 AMR 좌표 (status pose → ACS)</div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span id="simPoseText" class="font-monospace small">(0.00, 0.00, 0.00)</span>
                        <span id="simMoveBadge" class="badge bg-secondary">Idle</span>
                    </div>
                    <div class="input-group input-group-sm">
                        <input id="simPx" type="number" step="0.01" class="form-control" placeholder="X (m)" />
                        <input id="simPy" type="number" step="0.01" class="form-control" placeholder="Y (m)" />
                        <input id="simPa" type="number" step="0.01" class="form-control" placeholder="Angle (rad)" />
                        <button class="btn btn-outline-secondary" onclick="simSetPose()">좌표 설정</button>
                    </div>
                    <div class="text-muted mt-1" style="font-size:0.72rem">
                        이동 완료 시 <a href="/Settings">설정 → 위치 태그 매핑</a>에 등록된 노드 좌표로 자동 갱신됩니다.
                    </div>
                    <div id="simResult" class="small text-danger mt-1"></div>
                </div>
            </div>

            @* 시퀀스 시작 카드 *@
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">시퀀스 제어</h5>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-2">
                        <div class="col-4">
                            <label class="form-label form-label-sm">NodeId</label>
                            <input type="text" id="nodeId" class="form-control form-control-sm" value="N0001" />
                        </div>
                        <div class="col-4">
                            <label class="form-label form-label-sm">JobType</label>
                            <select id="jobType" class="form-select form-select-sm">
                                <option value="">없음</option>
                                <option value="LOAD">LOAD</option>
                                <option value="UNLOAD">UNLOAD</option>
                                <option value="EXCHANGE">EXCHANGE (설비 도킹)</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label form-label-sm">PortType</label>
                            <select id="portType" class="form-select form-select-sm">
                                <option value="EQP">설비포트 (EQP)</option>
                                <option value="MATERIAL">자재포트</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-4">
                            <label class="form-label form-label-sm">Port (슬롯)</label>
                            <select id="port" class="form-select form-select-sm">
                                <option value="LEFT">LEFT (슬롯1)</option>
                                <option value="RIGHT">RIGHT (슬롯2)</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label form-label-sm">AMR Slot</label>
                            <select id="amrSlot" class="form-select form-select-sm">
                                <option value="1">Port 1</option>
                                <option value="2">Port 2</option>
                                <option value="3">Port 3</option>
                                <option value="4">Port 4</option>
                            </select>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button id="btnStart" class="btn btn-primary btn-sm flex-fill" onclick="startSequence()">
                            <i class="bi bi-play-fill"></i> Start Sequence
                        </button>
                        <button id="btnAbort" class="btn btn-danger btn-sm" onclick="abortSequence()" disabled>
                            <i class="bi bi-stop-fill"></i> Abort
                        </button>
                    </div>
                </div>
            </div>

            @* 데모 모드 카드 *@
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Demo Mode</h5>
                    <span id="demoStatus" class="badge bg-secondary">Stopped</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-2">
                        N001 ↔ N006 자재포트 LEFT / AMR Port1 LOAD·UNLOAD 반복
                    </p>
                    <div class="d-flex gap-2 mb-2">
                        <button id="btnStartDemo" class="btn btn-success btn-sm flex-fill" onclick="startDemo()">
                            <i class="bi bi-arrow-repeat"></i> Start Demo
                        </button>
                        <button id="btnStopDemo" class="btn btn-outline-danger btn-sm flex-fill" onclick="stopDemo()" disabled>
                            <i class="bi bi-stop-circle"></i> Stop Demo
                        </button>
                    </div>
                    <div id="demoInfo" class="small text-muted d-none">
                        <span id="demoCycleInfo"></span>
                    </div>
                </div>
            </div>

            @* ActionCmd 수동 주입 (설비포트 테스트용) *@
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">ActionCmd 송신 (설비포트 테스트)</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-2">
                        설비포트(EQP) 시퀀스가 <code>WaitActionCmd</code> 단계에서 멈춰있을 때 트리거.
                        ActionCmd 의 Port 가 MoveCmd 의 Port 를 <strong>덮어씁니다</strong>.
                        EXCHANGE 게이트 진행 시엔 Type(UNLOAD/LOAD)을 지정하세요.
                    </p>
                    <div class="row g-2 mb-2">
                        <div class="col-5">
                            <label class="form-label form-label-sm">Type (EXCHANGE 게이트)</label>
                            <select id="actionType" class="form-select form-select-sm">
                                <option value="">(없음 — moveCmd 용)</option>
                                <option value="UNLOAD">UNLOAD (취출 허가)</option>
                                <option value="LOAD">LOAD (투입 허가)</option>
                            </select>
                        </div>
                        <div class="col-7">
                            <label class="form-label form-label-sm">Job ID (EXCHANGE)</label>
                            <input id="actionJobId" class="form-control form-control-sm" placeholder="(비우면 무조건 수용)" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-5">
                            <label class="form-label form-label-sm">Port (덮어쓰기)</label>
                            <select id="actionPort" class="form-select form-select-sm">
                                <option value="">(없음 — MoveCmd 유지)</option>
                                <option value="LEFT">LEFT (슬롯1)</option>
                                <option value="RIGHT">RIGHT (슬롯2)</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label form-label-sm">AMR Slot</label>
                            <select id="actionAmrSlot" class="form-select form-select-sm">
                                <option value="1">Port 1</option>
                                <option value="2">Port 2</option>
                                <option value="3">Port 3</option>
                                <option value="4">Port 4</option>
                            </select>
                        </div>
                        <div class="col-3 d-flex align-items-end">
                            <button id="btnSendActionCmd" class="btn btn-warning btn-sm w-100" onclick="sendActionCmd()">
                                <i class="bi bi-send"></i> 송신
                            </button>
                        </div>
                    </div>
                    <div id="actionCmdResult" class="small text-muted"></div>
                </div>
            </div>

            @* EXCHANGE v0.3 테스트 안내 — ACS 가 구간별 moveCmd/actionCmd 로 지시 *@
            <div class="card mb-3 border-primary">
                <div class="card-header">
                    <h5 class="card-title mb-0">Exchange (v0.3) 테스트 순서</h5>
                </div>
                <div class="card-body small">
                    <ol class="mb-2 ps-3">
                        <li><strong>시퀀스 제어</strong>에서 JobType=<code>UNLOAD</code>, PortType=자재포트, AMR Slot=투입슬롯(1|2) → Start (픽업지 NEW 적재)</li>
                        <li>JobType=<code>EXCHANGE</code>, PortType=설비포트, Port, AMR Slot=투입슬롯 → Start → 도착·도킹 후 <span class="badge bg-info">ExchangeDocked</span> 대기</li>
                        <li><strong>ActionCmd 송신</strong> Type=<code>UNLOAD</code>, AMR Slot=회수슬롯(3|4) → OLD 취출 → COMPLETED(30)</li>
                        <li>ActionCmd Type=<code>LOAD</code>, AMR Slot=투입슬롯(1|2) → NEW 투입 → COMPLETED(40)</li>
                        <li>JobType=<code>LOAD</code>, PortType=자재포트, AMR Slot=회수슬롯 → Start (반납지 하역)</li>
                    </ol>
                    <div class="text-muted">같은 Job ID(cmdId) 를 쓰려면 아래 Job ID 칸에 입력하세요. 비우면 자동 생성됩니다.</div>
                    <div class="input-group input-group-sm mt-1">
                        <span class="input-group-text">Job ID</span>
                        <input id="seqJobId" class="form-control" placeholder="(선택) EX2026…" />
                        <span class="input-group-text">Model</span>
                        <input id="seqModel" class="form-control" placeholder="(선택)" />
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">Exchange 시퀀스 (매거진 교환 테스트)</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-2">
                        픽업지 → 설비(취출/투입 허가 게이트 2회) → 반납지.
                        게이트는 위 <strong>ActionCmd 송신</strong>에서 Type=UNLOAD → LOAD 순서로 진행하세요.
                    </p>
                    <div class="row g-2 mb-2">
                        <div class="col-4">
                            <label class="form-label form-label-sm">픽업 Node</label>
                            <input id="exLoadSource" class="form-control form-control-sm" value="N001" />
                        </div>
                        <div class="col-4">
                            <label class="form-label form-label-sm">설비 Node</label>
                            <input id="exEquip" class="form-control form-control-sm" value="N002" />
                        </div>
                        <div class="col-4">
                            <label class="form-label form-label-sm">반납 Node</label>
                            <input id="exUnloadDest" class="form-control form-control-sm" value="N001" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-3">
                            <label class="form-label form-label-sm">설비 Port</label>
                            <select id="exPort" class="form-select form-select-sm">
                                <option value="LEFT">LEFT</option>
                                <option value="RIGHT">RIGHT</option>
                            </select>
                        </div>
                        <div class="col-3">
                            <label class="form-label form-label-sm">투입 슬롯</label>
                            <select id="exLoadSlot" class="form-select form-select-sm">
                                <option value="1">1</option>
                                <option value="2">2</option>
                            </select>
                        </div>
                        <div class="col-3">
                            <label class="form-label form-label-sm">회수 슬롯</label>
                            <select id="exUnloadSlot" class="form-select form-select-sm">
                                <option value="3">3</option>
                                <option value="4">4</option>
                            </select>
                        </div>
                        <div class="col-3">
                            <label class="form-label form-label-sm">Model</label>
                            <input id="exModel" class="form-control form-control-sm" placeholder="(선택)" />
                        </div>
                    </div>
                    <button id="btnStartExchange" class="btn btn-success btn-sm w-100" onclick="startExchange()">
                        <i class="bi bi-arrow-repeat"></i> Start Exchange
                    </button>
                    <div id="exchangeResult" class="small text-muted mt-1"></div>
                </div>
            </div>

            @* 현재 상태 정보 *@
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">현재 상태</h5>
                </div>
                <div class="card-body p-2">
                    <table class="table table-sm table-borderless mb-0">
                        <tr><td class="text-muted" style="width:100px">CmdId</td><td id="infoCmdId">-</td></tr>
                        <tr><td class="text-muted">NodeId</td><td id="infoNodeId">-</td></tr>
                        <tr><td class="text-muted">JobType</td><td id="infoJobType">-</td></tr>
                        <tr><td class="text-muted">PortType</td><td id="infoPortType">-</td></tr>
                        <tr><td class="text-muted">Port</td><td id="infoPort">-</td></tr>
                        <tr><td class="text-muted">AMR Slot</td><td id="infoAmrSlot">-</td></tr>
                        <tr><td class="text-muted">시작 시각</td><td id="infoStartedAt">-</td></tr>
                        <tr><td class="text-muted">Step 시작</td><td id="infoStepStartedAt">-</td></tr>
                    </table>
                </div>
            </div>

            @* Step 진행 표시기 *@
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Step 진행</h5>
                </div>
                <div class="card-body p-2">
                    <div class="list-group list-group-flush" id="stepList">
                        <div class="list-group-item py-1 px-2 d-flex align-items-center" data-step="1">
                            <span class="badge bg-secondary me-2 step-badge" style="width:24px">1</span>
                            <small>MoveCmdReceived — moveCmd 수신</small>
                        </div>
                        <div class="list-group-item py-1 px-2 d-flex align-items-center" data-step="2">
                            <span class="badge bg-secondary me-2 step-badge" style="width:24px">2</span>
                            <small>MoveCmdReply — ACCEPTED 응답</small>
                        </div>
                        <div class="list-group-item py-1 px-2 d-flex align-items-center" data-step="3">
                            <span class="badge bg-secondary me-2 step-badge" style="width:24px">3</span>
                            <small>SendMoveCommand — AMR 이동 명령</small>
                        </div>
                        <div class="list-group-item py-1 px-2 d-flex align-items-center" data-step="4">
                            <span class="badge bg-secondary me-2 step-badge" style="width:24px">4</span>
                            <small>WaitArrival — 도착 대기</small>
                        </div>
                        <div class="list-group-item py-1 px-2 d-flex align-items-center" data-step="5">
                            <span class="badge bg-secondary me-2 step-badge" style="width:24px">5</span>
                            <small>WaitActionCmd — ActionCmd 대기</small>
                        </div>
                        <div class="list-group-item py-1 px-2 d-flex align-items-center" data-step="6">
                            <span class="badge bg-secondary me-2 step-badge" style="width:24px">6</span>
                            <small>CobotQrPosition — QR 읽기 위치</small>
                        </div>
                        <div class="list-group-item py-1 px-2 d-flex align-items-center" data-step="7">
                            <span class="badge bg-secondary me-2 step-badge" style="width:24px">7</span>
                            <small>CameraQrRead — QR 인식/offset</small>
                        </div>
                        <div class="list-group-item py-1 px-2 d-flex align-items-center" data-step="8">
                            <span class="badge bg-secondary me-2 step-badge" style="width:24px">8</span>
                            <small>CobotPickup — PICKUP</small>
                        </div>
                        <div class="list-group-item py-1 px-2 d-flex align-items-center" data-step="9">
                            <span class="badge bg-secondary me-2 step-badge" style="width:24px">9</span>
                            <small>CobotPlace — PLACE (AMR Port 1)</small>
                        </div>
                        <div class="list-group-item py-1 px-2 d-flex align-items-center" data-step="10">
                            <span class="badge bg-secondary me-2 step-badge" style="width:24px">10</span>
                            <small>Complete — 완료 통보</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── 오른쪽: 수동 Step 실행 + 에러 ── *@
        <div class="col-lg-7 mb-3">
            @* 수동 Step 실행 카드 *@
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">수동 Step 실행</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-2">시퀀스가 실행 중이지 않을 때, 개별 Step을 수동으로 실행하여 테스트할 수 있습니다.</p>
                    <div class="row g-2" id="manualStepButtons">
                        <div class="col-6 col-md-4">
                            <button class="btn btn-outline-primary btn-sm w-100 manual-step-btn" data-step="MoveCmdReceived" onclick="executeStep('MoveCmdReceived')">
                                <strong>1</strong> MoveCmdReceived
                            </button>
                        </div>
                        <div class="col-6 col-md-4">
                            <button class="btn btn-outline-primary btn-sm w-100 manual-step-btn" data-step="MoveCmdReply" onclick="executeStep('MoveCmdReply')">
                                <strong>2</strong> MoveCmdReply
                            </button>
                        </div>
                        <div class="col-6 col-md-4">
                            <button class="btn btn-outline-primary btn-sm w-100 manual-step-btn" data-step="SendMoveCommand" onclick="executeStep('SendMoveCommand')">
                                <strong>3</strong> SendMoveCommand
                            </button>
                        </div>
                        <div class="col-6 col-md-4">
                            <button class="btn btn-outline-primary btn-sm w-100 manual-step-btn" data-step="WaitArrival" onclick="executeStep('WaitArrival')">
                                <strong>4</strong> WaitArrival
                            </button>
                        </div>
                        <div class="col-6 col-md-4">
                            <button class="btn btn-outline-primary btn-sm w-100 manual-step-btn" data-step="WaitActionCmd" onclick="executeStep('WaitActionCmd')">
                                <strong>5</strong> WaitActionCmd
                            </button>
                        </div>
                        <div class="col-6 col-md-4">
                            <button class="btn btn-outline-primary btn-sm w-100 manual-step-btn" data-step="CobotQrPosition" onclick="executeStep('CobotQrPosition')">
                                <strong>6</strong> CobotQrPosition
                            </button>
                        </div>
                        <div class="col-6 col-md-4">
                            <button class="btn btn-outline-primary btn-sm w-100 manual-step-btn" data-step="CameraQrRead" onclick="executeStep('CameraQrRead')">
                                <strong>7</strong> CameraQrRead
                            </button>
                        </div>
                        <div class="col-6 col-md-4">
                            <button class="btn btn-outline-primary btn-sm w-100 manual-step-btn" data-step="CobotPickup" onclick="executeStep('CobotPickup')">
                                <strong>8</strong> CobotPickup
                            </button>
                        </div>
                        <div class="col-6 col-md-4">
                            <button class="btn btn-outline-primary btn-sm w-100 manual-step-btn" data-step="CobotPlace" onclick="executeStep('CobotPlace')">
                                <strong>9</strong> CobotPlace
                            </button>
                        </div>
                        <div class="col-6 col-md-4">
                            <button class="btn btn-outline-primary btn-sm w-100 manual-step-btn" data-step="Complete" onclick="executeStep('Complete')">
                                <strong>10</strong> Complete
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @* 에러 표시 *@
            <div id="errorAlert" class="alert alert-danger d-none mb-3">
                <strong>Error:</strong> <span id="errorMessage"></span>
            </div>

            @* 실행 로그 카드 *@
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">실행 로그</h5>
                    <div class="btn-group">
                        <a class="btn btn-outline-primary btn-sm" href="/Sequence?handler=ExportCsv&count=200" download>CSV 다운로드</a>
                        <button class="btn btn-outline-secondary btn-sm" onclick="clearLogs()">Clear</button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div style="max-height: 400px; overflow-y: auto;" id="logContainer">
                        <table class="table table-sm table-striped mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th style="width:90px">시간</th>
                                    <th style="width:140px">Step</th>
                                    <th>메시지</th>
                                </tr>
                            </thead>
                            <tbody id="logBody">
                                <tr><td colspan="3" class="text-muted text-center">로그 없음</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let pollTimer = null;
    let lastLogCount = 0;

    // Step 이름 → 번호 매핑
    const stepNumbers = {
        'Idle': 0, 'MoveCmdReceived': 1, 'MoveCmdReply': 2, 'SendMoveCommand': 3,
        'WaitArrival': 4, 'WaitActionCmd': 5, 'CobotQrPosition': 6, 'CameraQrRead': 7,
        'CobotPickup': 8, 'CobotPlace': 9, 'Complete': 10,
        'ExchangeDocked': 21, 'ExchangeAction': 22, 'Faulted': 99
    };

    function startPolling() {
        stopPolling();
        pollState();
        pollLogs();
        pollTimer = setInterval(function () {
            pollState();
            pollLogs();
        }, 1500);
    }

    function stopPolling() {
        if (pollTimer) {
            clearInterval(pollTimer);
            pollTimer = null;
        }
    }

    function pollState() {
        $.getJSON('/Sequence?handler=State', function (res) {
            updateStateUI(res);
        });
    }

    function pollLogs() {
        $.getJSON('/Sequence?handler=Logs&count=100', function (res) {
            updateLogsUI(res);
        });
    }

    function updateStateUI(state) {
        // 상태 배지
        var badge = $('#seqStatus');
        if (state.isRunning) {
            badge.removeClass('bg-secondary bg-danger bg-success').addClass('bg-primary');
            badge.text('Running: ' + state.stepName);
        } else if (state.stepName === 'Faulted') {
            badge.removeClass('bg-secondary bg-primary bg-success').addClass('bg-danger');
            badge.text('Faulted');
        } else {
            badge.removeClass('bg-primary bg-danger bg-success').addClass('bg-secondary');
            badge.text('Idle');
        }

        // 현재 상태 정보
        $('#infoCmdId').text(state.cmdId);
        $('#infoNodeId').text(state.nodeId);
        $('#infoJobType').text(state.jobType);
        $('#infoPortType').text(state.portType);
        $('#infoPort').text(state.port);
        $('#infoAmrSlot').text(state.amrSlot);
        $('#infoStartedAt').text(state.startedAt || '-');
        $('#infoStepStartedAt').text(state.stepStartedAt || '-');

        // 에러 표시
        if (state.error) {
            $('#errorAlert').removeClass('d-none');
            $('#errorMessage').text(state.error);
        } else {
            $('#errorAlert').addClass('d-none');
        }

        // 데모 상태 표시
        var demoBadge = $('#demoStatus');
        if (state.isDemoRunning) {
            demoBadge.removeClass('bg-secondary').addClass('bg-success');
            var stepLabels = ['N001 LOAD', 'N001 UNLOAD', 'N006 LOAD', 'N006 UNLOAD'];
            var label = stepLabels[state.demoStepIndex] || '';
            demoBadge.text('Running');
            $('#demoInfo').removeClass('d-none');
            $('#demoCycleInfo').text('Cycle #' + state.demoCycle + ' — ' + (state.demoStepIndex + 1) + '/4 ' + label);
        } else {
            demoBadge.removeClass('bg-success').addClass('bg-secondary');
            demoBadge.text('Stopped');
            $('#demoInfo').addClass('d-none');
        }

        // 데모/시퀀스 버튼 상태
        var busy = state.isRunning || state.isDemoRunning;
        $('#btnStartDemo').prop('disabled', busy);
        $('#btnStopDemo').prop('disabled', !state.isDemoRunning);

        // 버튼 상태
        $('#btnStart').prop('disabled', busy);
        $('#btnAbort').prop('disabled', !state.isRunning);
        $('.manual-step-btn').prop('disabled', busy);

        // Step 진행 표시기 업데이트
        var currentStepNum = state.currentStep;
        $('#stepList .list-group-item').each(function () {
            var stepNum = parseInt($(this).data('step'));
            var badge = $(this).find('.step-badge');

            badge.removeClass('bg-success bg-primary bg-secondary bg-danger');

            if (state.stepName === 'Faulted' && stepNum === currentStepNum) {
                badge.addClass('bg-danger');
                $(this).addClass('list-group-item-danger').removeClass('list-group-item-primary list-group-item-success');
            } else if (state.isRunning && stepNum === currentStepNum) {
                badge.addClass('bg-primary');
                $(this).addClass('list-group-item-primary').removeClass('list-group-item-danger list-group-item-success');
            } else if (stepNum < currentStepNum && currentStepNum > 0 && currentStepNum <= 10) {
                badge.addClass('bg-success');
                $(this).addClass('list-group-item-success').removeClass('list-group-item-danger list-group-item-primary');
            } else {
                badge.addClass('bg-secondary');
                $(this).removeClass('list-group-item-danger list-group-item-primary list-group-item-success');
            }
        });
    }

    function updateLogsUI(logs) {
        if (logs.length === 0 && lastLogCount === 0) return;

        var tbody = $('#logBody');
        if (logs.length === 0) {
            tbody.html('<tr><td colspan="3" class="text-muted text-center">로그 없음</td></tr>');
            lastLogCount = 0;
            return;
        }

        if (logs.length === lastLogCount) return;
        lastLogCount = logs.length;

        var html = '';
        for (var i = 0; i < logs.length; i++) {
            var log = logs[i];
            var badgeClass = log.isError ? 'bg-danger' : 'bg-info';
            html += '<tr' + (log.isError ? ' class="table-danger"' : '') + '>'
                + '<td><small>' + log.timestamp + '</small></td>'
                + '<td><span class="badge ' + badgeClass + '">' + log.step + '</span></td>'
                + '<td><small>' + log.message + '</small></td>'
                + '</tr>';
        }
        tbody.html(html);

        // 자동 스크롤
        var container = document.getElementById('logContainer');
        container.scrollTop = container.scrollHeight;
    }

    function startSequence() {
        var data = {
            nodeId: $('#nodeId').val(),
            port: $('#port').val(),
            jobType: $('#jobType').val(),
            portType: $('#portType').val(),
            amrSlot: parseInt($('#amrSlot').val()) || 1,
            jobId: $('#seqJobId').val() || null,
            model: $('#seqModel').val() || null
        };

        $.ajax({
            url: '/Sequence?handler=Start',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (res) {
                if (!res.success) {
                    alert('시퀀스 시작 실패: ' + res.error);
                }
            },
            error: function () {
                alert('시퀀스 시작 요청 실패');
            }
        });
    }

    function executeStep(stepName) {
        var data = {
            step: stepName,
            nodeId: $('#nodeId').val(),
            port: $('#port').val(),
            jobType: $('#jobType').val(),
            portType: $('#portType').val(),
            amrSlot: parseInt($('#amrSlot').val()) || 1
        };

        $.ajax({
            url: '/Sequence?handler=ExecuteStep',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (res) {
                if (!res.success) {
                    alert('Step 실행 실패: ' + res.error);
                }
            },
            error: function () {
                alert('Step 실행 요청 실패');
            }
        });
    }

    function abortSequence() {
        if (!confirm('시퀀스를 중단하시겠습니까?')) return;

        $.ajax({
            url: '/Sequence?handler=Abort',
            method: 'POST',
            success: function (res) {
                if (!res.success) {
                    alert('중단 실패: ' + res.error);
                }
            }
        });
    }

    function startDemo() {
        if (!confirm('데모 모드를 시작하시겠습니까?\nN001 ↔ N006 LOAD/UNLOAD 반복 실행')) return;

        $.ajax({
            url: '/Sequence?handler=StartDemo',
            method: 'POST',
            success: function (res) {
                if (!res.success) {
                    alert('데모 시작 실패: ' + res.error);
                }
            },
            error: function () {
                alert('데모 시작 요청 실패');
            }
        });
    }

    function stopDemo() {
        if (!confirm('데모 모드를 정지하시겠습니까?\n현재 시퀀스 완료 후 중지됩니다.')) return;

        $.ajax({
            url: '/Sequence?handler=StopDemo',
            method: 'POST',
            success: function (res) {
                if (!res.success) {
                    alert('데모 정지 실패: ' + res.error);
                }
            },
            error: function () {
                alert('데모 정지 요청 실패');
            }
        });
    }

    function clearLogs() {
        lastLogCount = 0;
        $('#logBody').html('<tr><td colspan="3" class="text-muted text-center">로그 없음</td></tr>');
    }

    // ===== 시뮬레이션 모드 (사무실 테스트) =====
    function pollSimState() {
        $.get('/Sequence?handler=SimState', function (s) {
            $('#simBadge').toggleClass('bg-info', s.enabled).toggleClass('bg-secondary', !s.enabled)
                .text(s.enabled ? 'ON' : 'OFF');
            if (s.pendingAction) {
                $('#simPendingBox').removeClass('d-none');
                $('#simIdleBox').addClass('d-none');
                $('#simPendingAction').text(s.pendingAction);
            } else {
                $('#simPendingBox').addClass('d-none');
                $('#simIdleBox').removeClass('d-none');
            }
            const setBtn = (id, on) => $(id)
                .toggleClass('btn-success', !!on).toggleClass('btn-outline-secondary', !on);
            setBtn('#simAmr1', s.amrSlots[0]); setBtn('#simAmr2', s.amrSlots[1]);
            setBtn('#simAmr3', s.amrSlots[2]); setBtn('#simAmr4', s.amrSlots[3]);
            setBtn('#simMat1', s.materialSlot1); setBtn('#simMat2', s.materialSlot2);
            $('#simPoseText').text('(' + Number(s.poseX).toFixed(2) + ', ' + Number(s.poseY).toFixed(2) + ', ' + Number(s.poseAngle).toFixed(2) + ')');
            $('#simMoveBadge').toggleClass('bg-primary', !!s.moving).toggleClass('bg-secondary', !s.moving)
                .text(s.moving ? 'Moving' : 'Idle');
        });
    }

    function simSetPose() {
        $.ajax({
            url: '/Sequence?handler=SimSetPose', method: 'POST', contentType: 'application/json',
            data: JSON.stringify({ X: parseFloat($('#simPx').val()) || 0, Y: parseFloat($('#simPy').val()) || 0, Angle: parseFloat($('#simPa').val()) || 0 }),
            success: function (res) { $('#simResult').text(res.success ? '' : res.error); pollSimState(); }
        });
    }
    setInterval(pollSimState, 1000);
    $(pollSimState);

    function simToggle(enabled) {
        $.ajax({
            url: '/Sequence?handler=SimToggle', method: 'POST', contentType: 'application/json',
            data: JSON.stringify({ Enabled: enabled }),
            success: function (res) { $('#simResult').text(res.success ? '' : res.error); pollSimState(); }
        });
    }

    function simConfirm() {
        $.ajax({
            url: '/Sequence?handler=SimConfirm', method: 'POST', contentType: 'application/json', data: '{}',
            success: function (res) { $('#simResult').text(res.success ? '' : res.error); pollSimState(); }
        });
    }

    function simFail() {
        $.ajax({
            url: '/Sequence?handler=SimFail', method: 'POST', contentType: 'application/json', data: '{}',
            success: function (res) { $('#simResult').text(res.success ? '' : res.error); pollSimState(); }
        });
    }

    function simToggleSlot(target) {
        const map = { amr1: '#simAmr1', amr2: '#simAmr2', amr3: '#simAmr3', amr4: '#simAmr4', mat1: '#simMat1', mat2: '#simMat2' };
        const on = $(map[target]).hasClass('btn-success');
        $.ajax({
            url: '/Sequence?handler=SimSetSlot', method: 'POST', contentType: 'application/json',
            data: JSON.stringify({ Target: target, Occupied: !on }),
            success: function (res) { $('#simResult').text(res.success ? '' : res.error); pollSimState(); }
        });
    }

    function sendActionCmd() {
        var payload = {
            Port: $('#actionPort').val(),
            AmrSlot: parseInt($('#actionAmrSlot').val(), 10),
            Type: $('#actionType').val(),
            JobId: $('#actionJobId').val()
        };
        var $btn = $('#btnSendActionCmd').prop('disabled', true);
        var $result = $('#actionCmdResult');
        $result.removeClass('text-success text-danger').addClass('text-muted').text('송신 중...');

        $.ajax({
            url: '/Sequence?handler=SendActionCmd',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {
                if (res.success) {
                    var portTxt = res.port || '(없음)';
                    $result.removeClass('text-muted text-danger').addClass('text-success')
                        .text('✓ 송신됨 — CmdId=' + res.cmdId + ', Port=' + portTxt + ', AmrSlot=' + res.amrSlot);
                } else {
                    $result.removeClass('text-muted text-success').addClass('text-danger')
                        .text('✗ 송신 실패: ' + res.error);
                }
            },
            error: function (xhr, status, err) {
                $result.removeClass('text-muted text-success').addClass('text-danger')
                    .text('✗ 요청 실패: ' + (err || status));
            },
            complete: function () { $btn.prop('disabled', false); }
        });
    }

    $(function () {
        startPolling();
    });
</script>
}
