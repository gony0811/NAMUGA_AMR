@page
@model AMR.Web.Pages.DepthCameraModel
@{
    ViewData["Title"] = "Depth Camera";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Depth Camera</h4>
        <span id="depthBadge" class="badge @(Model.IsConnected ? "bg-success" : "bg-secondary")">
            Depth: @(Model.IsConnected ? "연결됨" : "확인 중...")
        </span>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header py-2">
                    <strong>Depth Camera (Orbbec Gemini 2)</strong>
                </div>
                <div class="card-body text-center p-2">
                    <img id="depthFeed" src="/DepthCamera?handler=Stream"
                         style="max-width: 100%; height: auto; border: 1px solid #ddd; background: #000;"
                         alt="Depth Camera Feed" />
                    <div id="depthError" class="alert alert-warning mt-2" style="display: none;">
                        Depth 카메라 연결이 끊어졌습니다. 재연결을 시도하고 있습니다...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var $badge = $('#depthBadge');
            var $error = $('#depthError');
            var $feed = $('#depthFeed');
            var wasConnected = @(Model.IsConnected ? "true" : "false");

            function checkStatus() {
                $.getJSON('/DepthCamera?handler=Status', function (data) {
                    if (data.connected) {
                        $badge.removeClass('bg-secondary bg-danger').addClass('bg-success').text('Depth: 연결됨');
                        $error.hide();
                        if (!wasConnected) {
                            $feed.attr('src', '/DepthCamera?handler=Stream&t=' + Date.now());
                        }
                        wasConnected = true;
                    } else {
                        $badge.removeClass('bg-success bg-secondary').addClass('bg-danger').text('Depth: 연결 끊김');
                        $error.show();
                        wasConnected = false;
                    }
                }).fail(function () {
                    $badge.removeClass('bg-success bg-secondary').addClass('bg-danger').text('Depth: 오류');
                });
            }

            setInterval(checkStatus, 3000);

            $feed.on('error', function () {
                setTimeout(function () {
                    $feed.attr('src', '/DepthCamera?handler=Stream&t=' + Date.now());
                }, 3000);
            });
        });
    </script>
}
