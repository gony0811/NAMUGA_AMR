{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5200",
  "ModbusSettings": {
    "IpAddress": "10.10.100.200",
    "Port": 502,
    "SlaveId": 1
  },
  "CobotModbusSettings": {
    "IpAddress": "10.10.100.201",
    "Port": 502,
    "SlaveId": 1
  },
  "IoModuleModbusSettings": {
    "IpAddress": "10.10.100.120",
    "Port": 502,
    "SlaveId": 20
  },
  "MqttSettings": {
    "BrokerAddress": "localhost",
    "BrokerPort": 1883,
    "ClientId": "AMR001",
    "Username": "guest",
    "Password": "guest"
  },
  "CameraSettings": {
    "DeviceIndex": 0,
    "FrameWidth": 1280,
    "FrameHeight": 720,
    "DepthFrameWidth": 640,
    "DepthFrameHeight": 480,
    "TargetFps": 15,
    "JpegQuality": 75,
    "DepthFx": 529.0,
    "DepthFy": 529.0
  }
}